{

"name": "Attention Manager",
"description": "Screentime Manager",
"version": "0.5",
"manifest_version": 3,

"action": {
	"default_icon": "graphics/solution-thinking-icon.png",
	"default_popup": "userInterface.html"
},

"permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  
"host_permissions": [
  "<all_urls>"
],

"background": {
    "service_worker": "scripts/background.js"
  },

"content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "<all_urls>"
      ]
    }
]

}